# Variables du VPS (design § 13.3). Copier en .env (droits 600) et remplir.
# Ne jamais mettre ici la clé service_role ni aucun autre secret de la CI.

# URL publique du site, sans « / » final.
APP_URL=https://rt-dash.example.org

# Domaine servi par Caddy (certificat HTTPS automatique). « localhost » en local.
DOMAIN=rt-dash.example.org

# Projet Supabase : URL et clé publique (anon / publishable).
# La clé publique est utilisée côté serveur avec la session de l'utilisateur ;
# sans compte RT-Dash actif, elle ne donne accès à rien (RLS).
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# API TruckersMP.
TRUCKERSMP_API_URL=https://api.truckersmp.com/v2

# Fuseau d'affichage et de saisie.
APP_TIMEZONE=Europe/Paris

# Image à déployer : ghcr.io/<GITHUB_OWNER>/rt-dash:<TAG>.
# TAG = empreinte (sha) d'un commit pour revenir à une version précise.
GITHUB_OWNER=pandaskys
TAG=latest
