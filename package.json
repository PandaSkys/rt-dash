{
  "name": "rt-dash",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "db:reset": "docker compose -f compose.dev.yml down -v && pnpm db:up && pnpm db:migrate",
    "db:types": "node --env-file-if-exists=.env.development.local scripts/db/generate-types.mjs",
    "db:test": "docker compose -f compose.dev.yml exec -T db pg_prove -U postgres -d rtdash --ext .sql -r /db-tests",
    "db:up": "docker compose -f compose.dev.yml up -d --build --wait db",
    "db:migrate": "node --env-file-if-exists=.env.development.local scripts/db/run-dbmate.mjs up"
  },
  "dependencies": {
    "arctic": "3.7.0",
    "kysely": "0.29.8",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dbmate": "2.37.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^31.0.0",
    "kysely-codegen": "0.20.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.20.0"
}
